# Configuração da aplicação (spec 007). Copie para .env e mude só o que precisar:
#   cp .env.example .env
# O .env fica fora do Git. Uma variável de ambiente com o mesmo nome vale mais que o .env,
# e o --port do `python -m app` vale mais que os dois. Só as variáveis abaixo são aceitas.

# Similaridade mínima para "mesma pessoa" (maior que 0 e até 1). 0.766 veio do E08 (D08).
FACE_APP_THRESHOLD=0.766

# Banco SQLite com as pessoas e os embeddings, criado sozinho na primeira execução (D12).
FACE_APP_DATABASE_PATH=data/private/app.db

# Checkpoint do modelo escolhido (D16). Vazio usa o FaceNet pré-treinado, sem fine-tuning (E01).
FACE_APP_CHECKPOINT_PATH=checkpoints/E06/best.pt

# Onde o modelo roda: auto (GPU quando existe), cpu ou cuda.
FACE_APP_DEVICE=auto

# Porta do servidor local, de 1024 a 65535. O endereço é sempre 127.0.0.1.
FACE_APP_PORT=8000

# Tamanho máximo de cada foto enviada, em MB (de 1 a 50).
FACE_APP_MAX_UPLOAD_MB=10

# Menor lado, em pixels, que a caixa de um rosto precisa ter para ser reconhecido (de 20 a 500).
# Rostos menores são ignorados. Provisório: o threshold foi medido com rostos grandes (D19).
FACE_APP_MIN_FACE_PX=80

# Nível mínimo dos logs no terminal: DEBUG, INFO, WARNING ou ERROR.
FACE_APP_LOG_LEVEL=INFO
